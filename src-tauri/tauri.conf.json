{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Upload Audit",
  "version": "0.1.5",
  "identifier": "in.sociobot.photo-upload-audit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/audit",
    "beforeBuildCommand": "npm run build:site",
    "frontendDist": "../dist/site"
  },
  "app": {
    "windows": [
      {
        "title": "Photo Upload Audit",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://api.sociobot.in"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dist/site/build.json": "build-provenance.json"
    },
    "category": "Utility",
    "shortDescription": "Verify every photo backup file",
    "longDescription": "Compare a camera export with a backup folder using SHA-256 hashes and Live Photo pair checks.",
    "copyright": "Copyright 2026 Param Factory",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
